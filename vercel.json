{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "flask",
      "entrypoint": "run:app",
      "buildCommand": "python deploy_db.py",
      "functions": {
        "run.py": {
          "excludeFiles": "{frontend/**,tests/**,docs/**,models/**,.venv/**,instance/**,tmp/**,logs/**,**/*.db,**/*.docx}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
