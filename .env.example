# Generate long random values before any non-local deployment.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret

# Local defaults
DATABASE_URL=sqlite:///app.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_ACCESS_TOKEN_EXPIRES=86400
FLASK_DEBUG=1

# Optional offline experimental category suggestions (restart after changes).
CLASSIFICATION_ENABLED=true
CLASSIFICATION_THREADS=2
CLASSIFICATION_MIN_SCORE=0.45
CLASSIFICATION_MIN_SUPPORT=0.70
CLASSIFICATION_MIN_MARGIN=0.25
# CLASSIFICATION_MODEL_PATH=C:/path/to/campus-loop/models/mdeberta
